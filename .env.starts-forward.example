# Leave keys empty to use the guided demo and local persistent records.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
# Change to a model available to your API account before live use.
MODEL=gpt-5.6-sol
AMBIGUOUS_API_KEY=

# Auth0 Regular Web Application (not the starter's M2M example).
AUTH0_ENABLED=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate once: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://127.0.0.1:3100
